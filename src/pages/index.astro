---
import BaseLayout from '@/layouts/BaseLayout.astro';
import logoSrc from '../../design/logo/system-sound-fhole-traced.svg';
import lineQrSrc from '../../images/contact/line-qr.jpg';

const assetPath = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;

const featuredWorks = [
  {
    number: '01',
    status: 'Operational prototype',
    category: 'AI Operations / SNS / Automation',
    title: 'AIとの会話から、Threads投稿・履歴・分析までを一つの運用へ。',
    copy: '投稿予約だけでなく、画像、ツリー投稿、履歴検索、エラー復旧、分析、トークン管理までをつないだSNS運用システムです。',
    flow: ['AI Chat', 'GitHub', 'Actions', 'Threads', 'Insights'],
    previewImage: assetPath('images/projects/threads-automation.svg'),
    previewAlt: 'AIとの会話からGitHub Actions、Threads投稿、履歴、分析までをつなぐSNS運用フロー図',
  },
  {
    number: '02',
    status: 'Public demo available',
    category: 'Small Tool / Image Processing / Privacy',
    title: '40枚の画像加工を、ブラウザだけで一つのZIPへ。',
    copy: '画像分割、背景除去、枚数選択、ファイル名調整、LINE申請用ZIP生成を、外部送信なしで完結するツールです。',
    flow: ['1 Image', 'Split', 'Remove BG', 'Select', 'ZIP'],
    previewImage: assetPath('images/projects/line-stamp-tool.svg'),
    previewAlt: 'LINEスタンプ画像の分割、背景除去、選択、ZIP生成までを行うブラウザツールのプレビュー',
  },
  {
    number: '03',
    status: 'MVP in development',
    category: 'Decision Support / Web App / API',
    title: '迷い続ける商品選びを、比較できる選定フローへ。',
    copy: '価格やレビューを行き来する商品選定を、検索・比較・スコアリングで支援する個人事業主向けWebアプリです。',
    flow: ['Search', 'Compare', 'Score', 'Decide'],
    previewImage: assetPath('images/projects/product-selection.svg'),
    previewAlt: '商品検索、比較、スコアリング、意思決定を支援するWebアプリのプレビュー',
  },
  {
    number: '04',
    status: 'Work in progress',
    category: 'AI Audio / Creative Workflow / UI',
    title: 'AI音声生成を、“一回試す”から“制作を続けられる流れ”へ。',
    copy: '声の設計、長文台本の分割生成、保存、試聴、SNS用動画変換をつないだ、AI音声制作の補助環境です。',
    flow: ['Voice Design', 'Script', 'Generate', 'Edit', 'Publish'],
    previewImage: assetPath('images/projects/ai-voice-workflow.svg'),
    previewAlt: '声の設計、台本分割、生成、編集、SNS公開までをつなぐAI音声制作フロー図',
  },
  {
    number: '05',
    status: 'Production workflow in development',
    category: 'Codex / Novel Production / GitHub',
    title: '一人の長編制作を、役割分担とレビューで止まらない流れへ。',
    copy: '企画、世界観・キャラクター正本、プロット、本文、監査、改稿、伏線同期、公開記録までを一つの制作システムとして設計。CodexとGitHubを使い、長編ライトノベルを継続制作できるワークフローを構築しています。',
    flow: ['Bible', 'Outline', 'Draft', 'Review', 'Release'],
    previewImage: assetPath('images/projects/novel-production.svg'),
    previewAlt: '設定正本、プロット、本文、レビュー、公開記録をCodexとGitHubで回す長編制作フロー図',
  },
  {
    number: '06',
    status: 'Production & sales completed',
    category: 'AI Creative / LINE Stickers / Sales',
    title: 'AIで40個を作るところから、申請・販売まで実際に回す。',
    copy: '表情バリエーションの生成、スタンプシート化、背景透過、main・tab画像、ZIP生成、LINE Creators Marketへの申請と審査対応までを実践。作って終わりではなく、販売までの工程を一通り検証しました。',
    flow: ['Generate', 'Prepare', 'ZIP', 'Review', 'Sell'],
    previewImage: assetPath('images/projects/line-stamp-production.svg'),
    previewAlt: 'AIでLINEスタンプ40個を作成し、画像調整、申請、審査対応、販売まで進める制作フロー図',
    url: 'https://note.com/goro_yattemiyo/n/n222268153952',
    linkLabel: 'noteで制作・販売の記録を見る',
  },
];

const processSteps = [
  ['01', 'Listen', '今の作業を聞く', '何を使っているかより、どこで止まり、何を毎回くり返しているかを整理します。'],
  ['02', 'Design', '小さく設計する', '最初から大規模化せず、現場で試せる最小単位へ分けます。'],
  ['03', 'Build', '実際に動かす', 'AI、Web、GitHub、スプレッドシートなど、必要なものだけを組み合わせます。'],
  ['04', 'Improve', '使いながら整える', '一度作って終わりではなく、実際の使い方に合わせて調整します。'],
];
---

<BaseLayout
  title="SYSTEM / SOUND｜永谷 悟郎"
  description="AIと小さな仕組みで、仕事の中にある『毎回面倒』を改善します。"
>
  <header>
    <a class="brand" href="#top">
      <img src={logoSrc.src} alt="" />
      <span>SYSTEM / SOUND</span>
    </a>
    <nav aria-label="主要メニュー">
      <a href="#story">STORY</a>
      <a href="#works">WORKS</a>
      <a href="#process">PROCESS</a>
      <a href="#about">ABOUT</a>
      <a href="#contact">CONTACT</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="shell hero-grid">
        <div>
          <p class="kicker">AI Solution Engineering / Music</p>
          <h1>面倒を、<span>仕組みに変える。</span></h1>
          <p class="hero-copy">仕事の中にある「毎回面倒」を、AIと小さな仕組みで改善する。現場で無理なく使い続けられる設計を、一緒に考えます。</p>
          <div class="actions">
            <a class="button primary" href="#contact">相談・連絡する</a>
            <a class="button" href="#works">事例を見る</a>
          </div>
        </div>
        <div class="mark-stage" aria-label="SYSTEM / SOUNDのF字孔シンボル">
          <div class="frequency" aria-hidden="true"></div>
          <div class="mark" style={`--mark-mask:url("${logoSrc.src}")`}>
            <svg class="orbit-svg orbit-back" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
              <ellipse cx="200" cy="60" rx="184" ry="42" pathLength="100" />
            </svg>
            <span class="mark-wood" aria-hidden="true"></span>
            <svg class="orbit-svg orbit-front" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <clipPath id="orbit-front-half">
                  <rect x="0" y="60" width="400" height="60" />
                </clipPath>
              </defs>
              <ellipse cx="200" cy="60" rx="184" ry="42" pathLength="100" clip-path="url(#orbit-front-half)" />
            </svg>
            <svg class="orbit-svg orbit-light" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <clipPath id="orbit-light-front-half">
                  <rect x="0" y="58" width="400" height="62" />
                </clipPath>
              </defs>
              <ellipse class="orbit-light-main" cx="200" cy="60" rx="184" ry="42" pathLength="100" clip-path="url(#orbit-light-front-half)" />
              <ellipse class="orbit-light-highlight" cx="200" cy="60" rx="184" ry="42" pathLength="100" clip-path="url(#orbit-light-front-half)" />
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section id="story">
      <div class="shell story-grid">
        <div class="story-visual" aria-hidden="true">
          <div class="story-frequency">
            <span class="frequency-ring ring-1"></span>
            <span class="frequency-ring ring-2"></span>
            <span class="frequency-ring ring-3"></span>
            <span class="frequency-ring ring-4"></span>
            <span class="frequency-sweep"></span>
          </div>
          <div class="story-cycle">
            <span>REPEAT</span><i>→</i><span>SIGNAL</span><i>→</i><span>IMPROVE</span>
          </div>
        </div>
        <div>
          <p class="kicker">Logo Story / Frequency</p>
          <h2>音楽のように、<br />改善を進める。</h2>
          <p class="lead">このロゴの原型は、コントラバスのF字孔です。楽器の内部で育った振動を、響きとして空気へ伝える出口。その形に、Frequencyの「F」と、仕事の流れを整えるSYSTEMの考え方を重ねています。</p>
          <p>音楽は、周期的な振動と変化の重なりで進んでいきます。仕事の中にも、毎日、毎週、毎月くり返される流れがあります。</p>
          <p>その反復に、AIと小さな仕組みで変化を与える。すると、止まっていた流れが整い、少しずつ前へ進みはじめます。</p>
          <p>曲が時間の中で展開していくように、業務改善もまた、周期的な変化を積み重ねながら進んでいく。それがSYSTEM / SOUNDの考え方です。</p>
        </div>
      </div>
    </section>

    <section id="works" class="works-section">
      <div class="shell">
        <div class="section-heading">
          <p class="kicker">Featured Works</p>
          <h2>作ったものではなく、<br />変えた流れを見る。</h2>
          <p class="lead">公開準備中のものを含め、現在取り組んでいる代表事例です。詳細ページを持たない案件は、概要図をフローティング表示して内容を確認できます。</p>
        </div>
        <div class="works-grid">
          {featuredWorks.map((work) => (
            <article class="work-card">
              <div class="work-meta"><span>{work.number}</span><span>{work.status}</span></div>
              <p class="work-category">{work.category}</p>
              <h3>{work.title}</h3>
              <p>{work.copy}</p>
              <div class="flow" aria-label="処理の流れ">
                {work.flow.map((item, index) => (
                  <><span>{item}</span>{index < work.flow.length - 1 && <i aria-hidden="true">→</i>}</>
                ))}
              </div>
              <button
                class="work-link preview-trigger"
                type="button"
                data-preview-image={work.previewImage}
                data-preview-title={work.title}
                data-preview-alt={work.previewAlt}
                data-preview-url={work.url ?? ''}
                data-preview-label={work.linkLabel ?? ''}
              >
                プレビューを見る<span aria-hidden="true">↗</span>
              </button>
            </article>
          ))}
        </div>
        <div class="private-cases">
          <p class="kicker">Anonymous Business Cases</p>
          <div class="private-grid">
            <article><span>Built / Anonymized</span><h3>工事情報から、仕様書・体制表・工程表などをまとめて生成。</h3><p>固有名詞・内部情報・実データを除き、工事仕様書作成プラットフォームの機能だけを再現しています。</p></article>
            <article><span>Built / Anonymized</span><h3>共有ストレージの技術資料を、収集・解析して検索DBへ。</h3><p>技術・保守資料を横断して探せるよう、文書抽出・タグ・確認状況を整理する仕組みです。</p></article>
            <article><span>Built / Anonymized</span><h3>19インチラックの機器配置を、ドラッグ＆ドロップで設計。</h3><p>空き判定、ポート管理、Excel・PowerPoint・PDF出力までを含む構成設計ツールです。</p></article>
            <article><span>Built / Anonymized</span><h3>大量の保守資料を横断検索し、障害対応に必要な情報へ素早く到達。</h3><p>全文検索、関連箇所・前後文表示、確認情報・手順提示をローカル環境で行う支援プログラムです。</p></article>
          </div>
          <button
            class="work-link preview-trigger private-preview"
            type="button"
            data-preview-image={assetPath('images/business-systems/business-systems-overview.svg')}
            data-preview-title="実務で設計・開発した業務支援システム"
            data-preview-alt="工事仕様書作成、技術資料検索DB、ラック構成設計、システム保守支援の4事例を匿名化してまとめたプレビュー"
          >
            4つの業務支援システムをまとめて見る<span aria-hidden="true">↗</span>
          </button>
        </div>
      </div>
    </section>

    <section id="process" class="process-section">
      <div class="shell">
        <div class="section-heading compact">
          <p class="kicker">Process</p>
          <h2>大きなシステムより、<br />続けられる小さな改善を。</h2>
        </div>
        <div class="process-grid">
          {processSteps.map(([number, en, title, copy]) => (
            <article class="process-card">
              <div><span>{number}</span><small>{en}</small></div>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="about">
      <div class="shell two-column">
        <div>
          <p class="kicker">About</p>
          <h2>論理と感覚の、<br />両方から設計する。</h2>
        </div>
        <div>
          <p class="lead">永谷 悟郎（ながや ごろう）</p>
          <p>AIソリューションエンジニアとして、業務改善、小規模自動化、AI活用の設計・制作に取り組んでいます。コントラバスとエレキベースの演奏活動も続けています。</p>
          <dl>
            <div class="fact"><dt>Work</dt><dd>AIソリューションエンジニア</dd></div>
            <div class="fact"><dt>Music</dt><dd>Contrabass &amp; Electric Bass Player</dd></div>
            <div class="fact"><dt>Education</dt><dd>国立音楽大学卒業</dd></div>
            <div class="fact"><dt>License</dt><dd>中学校・高等学校教諭免許状（音楽）</dd></div>
            <div class="fact"><dt>Base</dt><dd>静岡県藤枝市</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="shell two-column">
        <div>
          <p class="kicker">Contact</p>
          <h2>仕事も、音楽も。<br />まずはLINEから。</h2>
          <p class="muted">AI・業務改善のご相談、学校・吹奏楽・地域音楽活動に関するご連絡を承ります。</p>
        </div>
        <div class="contact-box">
          <strong>永谷 悟郎 / ながや ごろう</strong>
          <div class="contact-list">
            <span>静岡県藤枝市</span>
            <span>ご連絡はLINEからお願いします。</span>
          </div>
          <a class="qr-link" href="https://line.me/ti/p/LNkfYpe0I3" target="_blank" rel="noopener noreferrer" aria-label="LINEで連絡する">
            <img class="line-qr" src={lineQrSrc.src} alt="永谷悟郎のLINE QRコード" width="220" height="220" loading="lazy" />
          </a>
          <a class="button line" href="https://line.me/ti/p/LNkfYpe0I3" target="_blank" rel="noopener noreferrer">LINEで連絡する</a>
        </div>
      </div>
    </section>
  </main>

  <dialog class="preview-dialog" id="work-preview" aria-labelledby="preview-title">
    <div class="preview-panel">
      <div class="preview-head">
        <div>
          <p class="kicker">Project Preview</p>
          <h2 id="preview-title">プロジェクトプレビュー</h2>
        </div>
        <button class="preview-close" type="button" aria-label="プレビューを閉じる">×</button>
      </div>
      <img class="preview-image" id="preview-image" src="" alt="" />
      <div class="preview-foot">
        <p>詳細ページが未公開の案件は、概要図のみを表示しています。</p>
        <a class="button preview-external" id="preview-external" href="#" target="_blank" rel="noopener noreferrer" hidden>外部ページを見る</a>
      </div>
    </div>
  </dialog>

  <footer><div class="shell">© SYSTEM / SOUND — Goro Nagaya</div></footer>
</BaseLayout>

<script is:inline>
  const previewDialog = document.querySelector('#work-preview');
  const previewImage = document.querySelector('#preview-image');
  const previewTitle = document.querySelector('#preview-title');
  const previewExternal = document.querySelector('#preview-external');
  const previewClose = document.querySelector('.preview-close');

  document.querySelectorAll('.preview-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!(previewDialog instanceof HTMLDialogElement) || !(previewImage instanceof HTMLImageElement) || !(previewTitle instanceof HTMLElement) || !(previewExternal instanceof HTMLAnchorElement)) return;
      const image = trigger.dataset.previewImage || '';
      const title = trigger.dataset.previewTitle || 'プロジェクトプレビュー';
      const alt = trigger.dataset.previewAlt || title;
      const url = trigger.dataset.previewUrl || '';
      const label = trigger.dataset.previewLabel || '外部ページを見る';

      previewImage.src = image;
      previewImage.alt = alt;
      previewTitle.textContent = title;
      if (url) {
        previewExternal.href = url;
        previewExternal.textContent = label;
        previewExternal.hidden = false;
      } else {
        previewExternal.hidden = true;
        previewExternal.removeAttribute('href');
      }
      previewDialog.showModal();
    });
  });

  previewClose?.addEventListener('click', () => {
    if (previewDialog instanceof HTMLDialogElement) previewDialog.close();
  });

  previewDialog?.addEventListener('click', (event) => {
    if (event.target === previewDialog && previewDialog instanceof HTMLDialogElement) previewDialog.close();
  });
</script>

<style>
  header{position:fixed;z-index:20;inset:0 0 auto;height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 max(20px,calc((100vw - 1120px)/2));background:rgba(11,11,12,.78);border-bottom:1px solid var(--color-line);backdrop-filter:blur(14px)}
  .brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-weight:700;letter-spacing:.08em}.brand img{width:24px;height:42px;object-fit:contain}nav{display:flex;gap:20px}nav a{text-decoration:none;color:var(--color-muted);font-size:.76rem}
  .hero{min-height:100svh;display:grid;place-items:center;padding:120px 0 72px;overflow:hidden;background:radial-gradient(circle at 70% 45%,rgba(110,61,36,.18),transparent 35%),linear-gradient(180deg,#0b0b0c,#111113)}
  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:64px}.hero h1{margin:0;font-size:clamp(2.8rem,7vw,6.5rem);line-height:1.03}.hero h1 span{display:block;color:var(--color-wood)}.hero-copy{max-width:680px;margin:26px 0;color:#d7d0c6;font-size:clamp(1rem,1.5vw,1.18rem)}
